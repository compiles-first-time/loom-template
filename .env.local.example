# Copy to .env.local and fill in. .env.local is gitignored (never commit real keys).
#
# Your Anthropic API key — used only by the server route at app/api/assistant/route.ts.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the assistant model (defaults to claude-opus-5).
# ASSISTANT_MODEL=claude-opus-5

# Optional: path to your extracted Last Epoch data directory (Phase 2).
# When set, the app loads real data from here instead of data/sample/.
# LE_DATA_DIR=./data/game
